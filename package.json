{
  "name": "@mgpl-diagnostics/report-kit",
  "version": "2.0.0",
  "description": "MGPL Diagnostics lab reports — BACKEND kit (Node.js): templates, React document rendering, pure Node A4 PDF, and an HTTP API for Next.js, Fastify, Express or any backend. Frontends use @mgpl-diagnostics/client.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "github:mgpl-diagnostics/report-kit",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "mgpl-report-assets": "bin/copy-assets.mjs"
  },
  "files": [
    "dist",
    "assets",
    "bin",
    "docs",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/sync-assets.mjs",
    "smoke": "tsx scripts/smoke-test.tsx",
    "examples": "tsx scripts/generate-examples.tsx",
    "prepare": "tsup",
    "llms": "node scripts/llms-full.mjs @mgpl-diagnostics/report-kit README.md AGENTS.md THIRD_PARTY_NOTICES.md llms.txt docs package.json src scripts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "bwip-js": "^4.11.4",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "fastify": ">=4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tabler/icons": "^3.49.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fastify": "^5.12.5",
    "fontkit": "^2.0.4",
    "opentype.js": "^2.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  }
}
